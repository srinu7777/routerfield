# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real API keys.

# Image Studio uses a two-provider fallback chain: Muse Image (Meta Model
# API) is tried first; OpenRouter is used automatically if Muse isn't
# configured or a request to it fails. See lib/imageProvider.js.

# Primary image provider — Meta Model API (Muse Image).
# Get a key at https://dev.meta.ai (requires sign-in). Optional: if unset,
# Image Studio uses OpenRouter directly with no fallback logic.
MODEL_API_KEY=your_meta_model_api_key
# Override only if you're proxying Meta's API through your own gateway.
MUSE_BASE_URL=https://api.meta.ai/v1

# Required for the Next.js app (app/, packages/studio). This key is read
# only server-side (see lib/openrouterServer.js) and is never sent to the
# browser — all generation requests go through this server's
# /api/openrouter/* routes. Also the ONLY provider for Video and Cinema
# Studio, and the fallback provider for Image Studio.
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional — override if you're proxying OpenRouter through your own
# gateway. Defaults to https://openrouter.ai/api/v1 if unset.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Note: the desktop/Electron build (src/) does NOT use this file — it has
# no server, so each user enters their own OpenRouter key in-app (stored in
# their browser's localStorage, sent directly to OpenRouter from there).
# The desktop build does not currently include Muse Image support.
